# Kopieren nach deploy/.env, Rechte auf Betreiber begrenzen; niemals committen.
# Alle Werte ausdrücklich ersetzen. Keine produktiven Secrets in Shellhistorie eingeben.
POSTGRES_PASSWORD=
MEMORYAFFE_SETUP_SECRET=
MEMORYAFFE_BASE_URL=https://memory.example.org
# Dasselbe Datenbankpasswort wie oben. Für zufällige hexadezimale Secrets ausgelegt.
MEMORYAFFE_DATABASE_CONNECTION=Host=db;Port=5432;Database=memoryaffe;Username=memoryaffe;Password=
MEMORYAFFE_HOST=memory.example.org
