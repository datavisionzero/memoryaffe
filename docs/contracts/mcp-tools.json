            "maximum": 100,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[\\x01-\\x7F]+$"
          }
        },
        "required": [],
        "additionalProperties": false,
        "$defs": {}
