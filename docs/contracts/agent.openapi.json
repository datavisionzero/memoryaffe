          "expectedRevision"
        ],
        "additionalProperties": false
      },
      "CreateTagInput": {
        "type": "object",
        "properties": {
          "vaultId": {
            "$ref": "#/components/schemas/Id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "required": [
          "vaultId",
          "name"
        ],
        "additionalProperties": false
      },
      "SearchInput": {
        "type": "object",
        "properties": {
          "vaultId": {
            "$ref": "#/components/schemas/Id"
          },
          "allVaults": {
            "const": true
          },
          "query": {
            "type": "string",
            "maxLength": 4096,
            "default": ""
          },
          "tagIds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Id"
            },
            "uniqueItems": true,
            "maxItems": 100
          },
          "tagMatch": {
            "type": "string",
            "enum": [
              "all",
              "any"
            ],
            "default": "all"
          },
          "sort": {
            "type": "string",
            "enum": [
              "relevance",
              "updatedAt"
            ]
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[\\x01-\\x7F]+$"
          }
